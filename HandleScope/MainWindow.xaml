<Window x:Class="HandleScope.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HandleScope"
        Width="1180"
        Height="760"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0F172A"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Handle" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="Scope" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                    <TextBlock Text="Find and close named Windows object handles"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="10,6"
                        Background="#123142"
                        BorderBrush="#28617A"
                        BorderThickness="1"
                        CornerRadius="14"
                        VerticalAlignment="Center">
                    <TextBlock Text="STANDARD USER"
                               Foreground="{StaticResource AccentHoverBrush}"
                               FontWeight="SemiBold"
                               FontSize="11" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="18,14,18,0"
                Padding="12,9"
                Background="#351923"
                BorderBrush="#7F1D3B"
                BorderThickness="1"
                CornerRadius="6">
            <DockPanel>
                <TextBlock Text="!"
                           FontWeight="Bold"
                           FontSize="16"
                           Foreground="#FDA4AF"
                           Margin="2,0,10,0" />
                <TextBlock Text="Closing a handle can crash an application, lose data, or destabilize Windows. Close only handles you recognize."
                           Foreground="#FECDD3"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="18,14,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="1. Choose a process" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Search by executable name or PID"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Refresh"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Click="RefreshProcesses_Click" />
                    </Grid>

                    <TextBox x:Name="ProcessSearchTextBox"
                             Grid.Row="1"
                             Margin="0,14,0,10"
                             ToolTip="Filter by process name or PID"
                             TextChanged="ProcessSearchTextBox_TextChanged" />

                    <DataGrid x:Name="ProcessesGrid"
                              Grid.Row="2"
                              IsReadOnly="True"
                              ItemsSource="{Binding ProcessesView}"
                              SelectionChanged="ProcessesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PROCESS"
                                                Binding="{Binding Name}"
                                                Width="*" />
                            <DataGridTextColumn Header="PID"
                                                Binding="{Binding PidDisplay}"
                                                Width="72" />
                            <DataGridTextColumn Header="HANDLES"
                                                Binding="{Binding HandleCountDisplay}"
                                                Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="2. Find a named handle" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedProcessText"
                                   Text="Select a process on the left"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,14,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HandleNameTextBox"
                                 ToolTip="A full object name or a fragment, for example: report.xlsx"
                                 KeyDown="HandleNameTextBox_KeyDown" />
                        <ComboBox x:Name="MatchModeComboBox"
                                  Grid.Column="1"
                                  Margin="8,0,0,0"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Contains" Tag="Contains" />
                            <ComboBoxItem Content="Exact name" Tag="Exact" />
                        </ComboBox>
                        <Button x:Name="ScanButton"
                                Grid.Column="2"
                                Content="Scan handles"
                                Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0"
                                Click="ScanHandles_Click" />
                        <Button x:Name="CancelButton"
                                Grid.Column="3"
                                Content="Cancel"
                                Margin="8,0,0,0"
                                Visibility="Collapsed"
                                Click="CancelScan_Click" />
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="Leave the name empty to list all named handles. Matching is case-insensitive."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Margin="1,0,0,10" />

                    <DataGrid x:Name="HandlesGrid"
                              Grid.Row="3"
                              IsReadOnly="True"
                              ItemsSource="{Binding Handles}"
                              SelectionChanged="HandlesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TYPE"
                                                Binding="{Binding ObjectType}"
                                                Width="100" />
                            <DataGridTextColumn Header="HANDLE"
                                                Binding="{Binding HandleDisplay}"
                                                Width="90" />
                            <DataGridTextColumn Header="ACCESS"
                                                Binding="{Binding AccessDisplay}"
                                                Width="105" />
                            <DataGridTextColumn Header="NAME"
                                                Binding="{Binding Name}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ResultSummaryText"
                                   Text="No scan results yet"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button x:Name="CopyAutomationButton"
                                Grid.Column="1"
                                Content="Copy recurring command"
                                IsEnabled="False"
                                ToolTip="Copy the restricted Roblox singleton-event automation command"
                                Margin="12,0,0,0"
                                Click="CopyAutomation_Click" />
                        <Button x:Name="CloseHandleButton"
                                Grid.Column="2"
                                Content="Close selected handle"
                                Style="{StaticResource DangerButton}"
                                IsEnabled="False"
                                Margin="12,0,0,0"
                                Click="CloseHandle_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="#0F172A"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" />
                <ProgressBar x:Name="ScanProgressBar"
                             Grid.Column="1"
                             Width="180"
                             Height="4"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource BorderBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
